{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "qtscout-api",
	"main": "src/entry.py",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["python_workers"],
	// Non-Python files the app reads from disk (catalogs, PDF templates, fonts,
	// logos). Python Workers expose bundled modules as files under the module root.
	"rules": [
		{ "type": "Text", "globs": ["**/*.json", "**/*.j2"], "fallthrough": true },
		{ "type": "Data", "globs": ["**/*.woff2", "**/*.jpeg"], "fallthrough": true }
	],
	// Reached only through the web Worker's service binding.
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "qtscout",
			"database_id": "cc04816a-498c-436e-a646-3be4ba4c4173",
			"migrations_dir": "d1/migrations"
		}
	],
	// Weekly backups (src/app/backup.py), expired by an R2 lifecycle rule after 180 days.
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "qtscout-backups" }],
	"triggers": { "crons": ["0 3 * * 1"] },
	// remote: the local simulator has no quickAction, so dev uses the real Browser Run.
	"browser": { "binding": "BROWSER", "remote": true },
	"ai": { "binding": "AI" },
	"vars": {
		"AUTH_MODE": "access",
		"ACCESS_TEAM_DOMAIN": "snowy-hall-cc58.cloudflareaccess.com",
		"ACCESS_AUD": "215a27e773f25d3c5e62c32a173903825dc5731c5d2dbc9def077ad81a5339c9",
		"CF_ACCOUNT_ID": "e0186649c2b4e92b7d6b4d4751c9ab47",
		"ACCESS_GROUP_ID": "eedbbcb8-85f2-4eab-bcb7-1cf09c3f5a15"
	},
	// Secret (wrangler secret put): CF_API_TOKEN.
	"observability": { "enabled": true }
}
