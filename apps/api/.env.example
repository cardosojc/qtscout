# Local development only (uvicorn). In the Worker these come from wrangler.jsonc
# "vars" and secrets (`npx wrangler secret put CF_API_TOKEN`).

# Local SQLite database (create with scripts/local_db.py). Unused in the Worker.
DATABASE_URL=sqlite:///./local.db

# Auth: Cloudflare Access (one-time PIN). The web + API share one hostname behind
# an Access application; the API verifies the Access JWT (RS256) offline.
AUTH_MODE=access
ACCESS_TEAM_DOMAIN=snowy-hall-cc58.cloudflareaccess.com
ACCESS_AUD=<Access application AUD tag>
# Local dev / Playwright only (no Access on localhost): trust every request as
# this email. NEVER in production.
# AUTH_MODE=dev
# AUTH_DEV_EMAIL=you@example.com

# Access group membership (user create/delete add/remove the email). Token needs
# Access: Organizations, Identity Providers, and Groups (Edit).
CF_API_TOKEN=<api token>
CF_ACCOUNT_ID=e0186649c2b4e92b7d6b4d4751c9ab47
ACCESS_GROUP_ID=<qtscout-users group id>
